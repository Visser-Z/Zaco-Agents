{
  "name": "zacoagents-desktop",
  "productName": "ZacoAgents",
  "version": "1.0.0",
  "description": "ZacoAgents — account-sales statements to Excel",
  "author": "ZacoAgents",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "za.co.zacodasboard.desktop",
    "productName": "ZacoAgents",
    "files": ["main.js", "preload.js", "config.json"],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZacoAgents",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
