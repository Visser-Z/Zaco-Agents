{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend,frontend}/**"
    }
  },
  "crons": [
    { "path": "/api/technofresh/cron", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index/$1" }
  ]
}
